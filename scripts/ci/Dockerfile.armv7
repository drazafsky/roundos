FROM debian:trixie-slim
ARG GO_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates curl libdrm-dev pkg-config python3 file \
    && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 "https://go.dev/dl/go${GO_VERSION}.linux-armv6l.tar.gz" -o /tmp/go.tar.gz \
    && curl --fail --location --retry 3 "https://go.dev/dl/go${GO_VERSION}.linux-armv6l.tar.gz.sha256" -o /tmp/go.sha256 \
    && echo "$(cat /tmp/go.sha256)  /tmp/go.tar.gz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz /tmp/go.sha256
ENV PATH="/usr/local/go/bin:${PATH}" GOARM=7
WORKDIR /src
